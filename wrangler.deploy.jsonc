{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploy config for the real Cloudflare Workers deployment, pointed at
  // vinext's build output (dist/server, dist/client) rather than the
  // TypeScript source in worker/index.ts — that source only runs correctly
  // under vinext's own dev/build pipeline, which has already produced the
  // real bundle by the time this file is used. Regenerate dist/ with
  // `npm run build` before deploying; this file itself is hand-maintained
  // and not overwritten by the build.
  "name": "aval",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Request waitUntil gives new tasks a fast start; this sweep is the
    // source-of-truth continuation and crash-recovery worker.
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aval-production",
      "database_id": "d82f33a0-a119-436c-85ec-b79873247fe9",
      "migrations_dir": "drizzle"
    }
  ]
}
